<!-- Virtual Asimov 1 - Enclosed Training Arena Environment -->
<!-- Direct MuJoCo XML with boundary perimeter walls and interactive physics bodies -->
<mujoco>
  <worldbody>
    <!-- Perimeter Boundary Walls -->
    <geom name="arena_wall_north" type="box" size="3.5 0.08 0.5" pos="0 3.5 0.5" rgba="0.4 0.45 0.55 0.8" />
    <geom name="arena_wall_south" type="box" size="3.5 0.08 0.5" pos="0 -3.5 0.5" rgba="0.4 0.45 0.55 0.8" />
    <geom name="arena_wall_east" type="box" size="0.08 3.5 0.5" pos="3.5 0 0.5" rgba="0.4 0.45 0.55 0.8" />
    <geom name="arena_wall_west" type="box" size="0.08 3.5 0.5" pos="-3.5 0 0.5" rgba="0.4 0.45 0.55 0.8" />

    <!-- Static Low Platform -->
    <geom name="arena_low_platform" type="box" size="0.6 0.6 0.025" pos="2.0 0.0 0.025" rgba="0.25 0.65 0.45 1.0" />

    <!-- Dynamic 6-DoF Movable Crates and Cylinders -->
    <body name="arena_box_red" pos="1.3 0.25 0.16">
      <freejoint name="arena_box_red_joint" />
      <geom name="arena_box_red_geom" type="box" size="0.14 0.14 0.14" mass="3.5" friction="1.0 0.005 0.0001" rgba="0.88 0.25 0.20 1.0" />
    </body>

    <body name="arena_ball_cyan" pos="0.85 -0.22 0.12">
      <freejoint name="arena_ball_cyan_joint" />
      <geom name="arena_ball_cyan_geom" type="sphere" size="0.11" mass="1.8" friction="0.8 0.005 0.0001" rgba="0.15 0.75 0.90 1.0" />
    </body>

    <body name="arena_cylinder_gold" pos="1.8 -0.30 0.18">
      <freejoint name="arena_cylinder_gold_joint" />
      <geom name="arena_cylinder_gold_geom" type="cylinder" size="0.08 0.18" mass="2.8" friction="1.0 0.005 0.0001" rgba="0.95 0.70 0.15 1.0" />
    </body>

    <body name="arena_trip_plank" pos="0.60 0.0 0.035">
      <freejoint name="arena_trip_plank_joint" />
      <geom name="arena_trip_plank_geom" type="box" size="0.12 0.35 0.035" mass="4.0" friction="1.2 0.005 0.0001" rgba="0.75 0.40 0.15 1.0" />
    </body>
  </worldbody>
</mujoco>
